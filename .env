# QA Analytics Platform - Environment Variables
# Development Configuration

# ============ FLASK CONFIGURATION ============
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py

# ============ SERVER CONFIGURATION ============
API_HOST=0.0.0.0
API_PORT=5000
SECRET_KEY=dev-secret-key-change-in-production

# ============ DATABASE CONFIGURATION ============
# For development (SQLite):
DATABASE_URL=sqlite:///qa_analytics.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql://qa_admin:secure_password@postgres:5432/qa_analytics

# ============ FILE UPLOAD CONFIGURATION ============
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=/tmp/qa_uploads

# ============ ANALYTICS CONFIGURATION ============
ANOMALY_CONTAMINATION=0.1
FORECAST_DAYS=7
LOOKBACK_DAYS=30

# ============ LOGGING CONFIGURATION ============
LOG_LEVEL=INFO
LOG_FILE=/tmp/qa_analytics.log

# ============ CORS CONFIGURATION ============
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ============ SECURITY CONFIGURATION ============
REQUIRE_AUTH=False
JWT_SECRET=dev-jwt-secret-key-change-in-production
